# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically.
# Access logs are deliberately off: expert review links carry their credential in the URL (/expert/<token>).
# If a `log` directive is ever added, exclude /expert/* and /api/expert/* from it (README §11).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:4000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
