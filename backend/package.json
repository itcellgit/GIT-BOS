{
  "name": "@acp/backend",
  "version": "0.2.0",
  "private": true,
  "description": "Express REST API: authentication, configuration, course lists. PostgreSQL via Prisma.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "super-admin": "node --env-file-if-exists=../.env scripts/super-admin.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@acp/shared": "*",
    "@fontsource/carlito": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.9",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
