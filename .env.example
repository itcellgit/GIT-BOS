# ---------------------------------------------------------------------------
# Academic Curriculum Portal — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection. Local dev (npm run db:start) uses the value below.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/acp"

# Better Auth: a long random secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=""
# Public URL of the portal (development: the Vite address; production: https://your-domain)
BETTER_AUTH_URL="http://localhost:5173"

# Optional single sign-on. Leave empty to hide the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Email (login codes). If SMTP_HOST is empty, codes are printed to the server console (development only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Academic Curriculum Portal <no-reply@example.edu>"

# Super Admin (full access; signs in with email + password). Created by `npm run db:seed`;
# reset a lost password with `npm run super-admin`. The initial password must be changed at first sign-in.
SUPER_ADMIN_EMAIL="admin@example.edu"
SUPER_ADMIN_NAME="Super Admin"
# 12+ characters with letters and digits. Leave empty to create the account without a password (email code only).
SUPER_ADMIN_PASSWORD=""

# PDF engine (headless Chromium). docker-compose.yml sets this for production. In development,
# leave it empty to use Playwright's Chromium (npx playwright install chromium).
GOTENBERG_URL=""

# ---------------------------------------------------------------------------
# Production only (docker-compose.yml on the VPS)
# ---------------------------------------------------------------------------
# Public domain served by Caddy, e.g. syllabus.example.edu (DNS A record → VPS IP)
DOMAIN=""
# PostgreSQL container credentials. DATABASE_URL is built from these inside compose.
POSTGRES_DB="acp"
POSTGRES_USER="acp"
POSTGRES_PASSWORD=""
