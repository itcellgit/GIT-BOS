# ---------------------------------------------------------------------------
# Academic Curriculum Portal — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection. Local dev: the PostgreSQL 17 server (managed in pgAdmin) on port 5432.
DATABASE_URL="postgresql://acp:CHANGE_ME@localhost:5432/acp"

# Better Auth: a long random secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=""
# Public URL of the portal (development: the Vite address; production: https://your-domain)
BETTER_AUTH_URL="http://localhost:5173"

# Google sign-in (how everyone except the Super Admin signs in). Create an OAuth client in Google Cloud
# Console (Web application) with the redirect URI  <BETTER_AUTH_URL>/api/auth/callback/google
# Only Google Workspace accounts of GOOGLE_HOSTED_DOMAIN can sign in, and only if the Administrator added them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_HOSTED_DOMAIN="git.edu"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Email (Super Admin password-reset codes; demo-account sign-in codes in development).
# If SMTP_HOST is empty, codes are printed to the server console (development only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Academic Curriculum Portal <no-reply@example.edu>"

# Workflow emails (backend/src/services/notifications.js). Defaults: production 30 s / 600 s, development 3 s / 10 s.
# NOTIFY_INTERVAL_SECONDS: how often due emails are sent; NOTIFY_DIGEST_SECONDS: how long inputs and comments are
# collected into one email. NOTIFY_SENDER=off: this process does not send (another one does).
NOTIFY_INTERVAL_SECONDS=""
NOTIFY_DIGEST_SECONDS=""

# Super Admin (full access; signs in with email + password). Created by `npm run db:seed`;
# reset a lost password with `npm run super-admin`. The initial password must be changed at first sign-in.
SUPER_ADMIN_EMAIL="admin@example.edu"
SUPER_ADMIN_NAME="Super Admin"
# 12+ characters with letters and digits. Leave empty to create the account without a password (email code only).
SUPER_ADMIN_PASSWORD=""

# Password a Super Admin can reset any user to (Users page → "Reset to default"). The user may keep it,
# so anyone who knows it can use reset accounts: tell users to change it under My account.
DEFAULT_RESET_PASSWORD="Password@123"

# PDF engine (headless Chromium). docker-compose.yml sets this for production. In development,
# leave it empty to use Playwright's Chromium (npx playwright install chromium).
GOTENBERG_URL=""

# ---------------------------------------------------------------------------
# Production only (docker-compose.yml on the VPS)
# ---------------------------------------------------------------------------
# Public domain served by Caddy, e.g. syllabus.example.edu (DNS A record → VPS IP)
DOMAIN=""
# PostgreSQL container credentials. DATABASE_URL is built from these inside compose.
POSTGRES_DB="acp"
POSTGRES_USER="acp"
POSTGRES_PASSWORD=""
